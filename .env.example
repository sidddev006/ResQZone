# ResQZone Environment Variables Template
# Copy this file to .env and fill in your private keys.
# .env is gitignored and will never be committed to git.

# CARTO GIS Basemap API Key (Get from https://carto.com/basemaps/apikey/)
CARTO_API_KEY=

# Google Gemini API Key (Optional for AI Copilot)
GEMINI_API_KEY=

# Mapbox Access Token (Optional for Satellite tiles)
MAPBOX_TOKEN=

# Backend Admin Secret
ADMIN_SECRET=resqzone-admin-sec-2026
