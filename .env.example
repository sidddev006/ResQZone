# ResQZone Environment Configuration

# Server
ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8000
SECRET_KEY=resqzone-hackathon-2026-super-secret-key-change-in-prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL + PostGIS in production/Docker, SQLite fallback locally)
DATABASE_URL=sqlite:///./resqzone.db
# DATABASE_URL=postgresql://resqzone:resqzone_password@localhost:5432/resqzone_db

# External Services Modes: LIVE | DEMO | OFFLINE
DATA_MODE=DEMO

# Optional External API Keys (Graceful fallback when missing)
IMD_API_KEY=
BHUVAN_API_KEY=
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
OPENSTREETMAP_API_URL=https://overpass-api.de/api/interpreter
FIREBASE_SERVER_KEY=
SMS_GATEWAY_API_KEY=

# GIS & ML Settings
DEMO_DISTRICT=Chamoli-Joshimath
ELEVATION_CONTOUR_INTERVAL=100
DEFAULT_RISK_THRESHOLD_CRITICAL=0.75
DEFAULT_RISK_THRESHOLD_WARNING=0.50
DEFAULT_RISK_THRESHOLD_WATCH=0.30

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
